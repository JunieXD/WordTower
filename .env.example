IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=juniexd
IMAGE_TAG=latest
APP_PORT=8080

POSTGRES_DB=wordtower
POSTGRES_USER=wordtower
POSTGRES_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-a-long-random-secret
# 本地 HTTP 使用 false；生产 HTTPS 必须改为 true
COOKIE_SECURE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_TO_STDOUT=true
WORDTOWER_DEBUG=false

SRS_ENABLED=false
SRS_TARGET_RECALL=0.8

ARK_API_KEY=
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_MODEL_ID=doubao-seed-2-0-mini-260215

DAILY_CHALLENGE_RESET_HOUR=6
DAILY_CHALLENGE_TIMEZONE=Asia/Shanghai
DAILY_CHALLENGE_PREWARM_COUNT=3
DAILY_CHALLENGE_LEADERBOARD_LIMIT=20
DAILY_CHALLENGE_CONFIG_PATH=config/daily_challenge.toml
