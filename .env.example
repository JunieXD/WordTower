IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=juniexd
IMAGE_TAG=latest
APP_PORT=8080

INFRA_NETWORK=1panel-network
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=wordtower
POSTGRES_USER=wordtower
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace-with-a-long-random-secret
# 本地 HTTP 使用 false；生产 HTTPS 必须改为 true
COOKIE_SECURE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_TO_STDOUT=true
WORDTOWER_DEBUG=false

SRS_ENABLED=false
SRS_TARGET_RECALL=0.8

ECNU_API_KEY=
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
ECNU_API_MODEL_ID=ecnu-plus

# 单进程共享并发上限（1-3）；同一学校账号在其他应用的调用也占用额度
ECNU_MAX_CONCURRENCY=3

DAILY_CHALLENGE_RESET_HOUR=6
DAILY_CHALLENGE_TIMEZONE=Asia/Shanghai
DAILY_CHALLENGE_PREWARM_COUNT=3
DAILY_CHALLENGE_LEADERBOARD_LIMIT=20
DAILY_CHALLENGE_CONFIG_PATH=config/daily_challenge.toml
