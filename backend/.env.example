# ==================== 核心 ====================
# JWT / 登录签名密钥
SECRET_KEY=wordtower

# HTTPS 部署时必须开启
COOKIE_SECURE=false

# ==================== 基础设施 ====================
# PostgreSQL 连接地址
DATABASE_URL=postgresql://postgres:123456@localhost:5432/wordtower

# Redis 连接地址
REDIS_URL=redis://localhost:6379/0

# 数据库连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# 默认关闭 SRS；启用时使用轻量启发式算法，不依赖 PyTorch
SRS_ENABLED=false

# ==================== 升级 ====================
# 升级生命值所需金币
UPGRADE_HP_COINS=100

# 升级攻击力所需金币
UPGRADE_ATTACK_COINS=100

# 升级暴击率所需金币
UPGRADE_CRIT_RATE_COINS=100

# 每次升级生命值提升量
UPGRADE_HP_VALUE=1

# 每次升级攻击力提升量
UPGRADE_ATTACK_VALUE=1

# 每次升级暴击率提升量
UPGRADE_CRIT_RATE_VALUE=0.01

# ==================== 大模型 ====================
# 华东师范大学 API Key
ECNU_API_KEY=

# 华东师范大学 API Base URL
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1

# 华东师范大学模型 ID
ECNU_API_MODEL_ID=ecnu-plus

# 单进程共享并发上限（1-3）；同一学校账号在其他应用的调用也占用额度
ECNU_MAX_CONCURRENCY=3

# ==================== 每日挑战：基础运行参数 ====================
# 每天几点刷新新的每日挑战，按 DAILY_CHALLENGE_TIMEZONE 解释
DAILY_CHALLENGE_RESET_HOUR=6

# 每日挑战使用的时区
DAILY_CHALLENGE_TIMEZONE=Asia/Shanghai

# 共享预热步数，控制提前预生成多少个后续共享题位
DAILY_CHALLENGE_PREWARM_COUNT=3

# 每日挑战排行榜默认返回前几名
DAILY_CHALLENGE_LEADERBOARD_LIMIT=20

# 每日挑战规则文件路径；默认已指向 config/daily_challenge.toml
# 如无特殊需求，可不改
DAILY_CHALLENGE_CONFIG_PATH=config/daily_challenge.toml

# 用户短时频率保护：8 次突发，每 3 秒恢复一次；没有每日额度
TRAFFIC_BURST=8
TRAFFIC_REFILL_SECONDS=3
TRAFFIC_COOLDOWN_SECONDS=15
